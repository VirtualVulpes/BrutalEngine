<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>BrutalEngine</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.4"/>
        <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5"/>
        <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.OpenAl" Version="2026.10.3"/>
        <PackageReference Include="Ahwoo.BRUTAL.OpenGl" Version="2026.10.2"/>
    </ItemGroup>

</Project>
